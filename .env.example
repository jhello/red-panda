# 复制为 .env 后按需修改。start-server.sh 会自动加载。
# 不要把真实密钥提交到版本库（.env 已在 .gitignore 中）。

# 监听
HOST=0.0.0.0
PORT=8787

# 数据目录与数据库（留空则用 <项目>/data）
# RED_PANDA_DATA_DIR=/var/lib/red-panda
# RED_PANDA_DB=/var/lib/red-panda/red-panda.db

# 管理员令牌（留空则自动生成并保存到 data/admin-token）
# RED_PANDA_ADMIN_TOKEN=change-me

# 登录会话闲置有效天数（每次使用自动续期，手动登出立即失效）
RED_PANDA_SESSION_DAYS=30

# 邮箱验证链接有效小时数 / 重置密码链接有效分钟数
RED_PANDA_VERIFY_HOURS=24
RED_PANDA_RESET_MINUTES=60

# 邮件里的链接使用哪个公开地址（留空则自动使用局域网地址）
# 部署到公网时务必设置，例如 https://red-panda.example.com
# RED_PANDA_PUBLIC_URL=https://red-panda.example.com

# 邮件发送方式：
#   log     默认。把邮件写入 data/outbox/*.eml，并在日志里打印验证/重置链接
#   command 把原始邮件通过管道交给命令，例如 msmtp
#   http    POST {from,to,subject,text,html} 到邮件 API
RED_PANDA_MAIL_MODE=log
RED_PANDA_MAIL_FROM="Red Panda <no-reply@red-panda.local>"
# RED_PANDA_MAIL_COMMAND=msmtp -t
# RED_PANDA_MAIL_API_URL=https://mail.example.com/send
# RED_PANDA_MAIL_API_KEY=change-me

# AI（留空则 AI 功能返回 503，其他功能不受影响）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 离线演示：设为 1 时不调用真实 API
# RED_PANDA_AI_MOCK=1
