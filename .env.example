# 复制为 .env 后按需修改。start-server.sh 会自动加载。
# 不要把真实密钥提交到版本库（.env 已在 .gitignore 中）。

# 监听
HOST=0.0.0.0
PORT=8787

# 数据目录与数据库（留空则用 <项目>/data）
# ODYSSEY_DATA_DIR=/var/lib/odyssey
# ODYSSEY_DB=/var/lib/odyssey/odyssey.db

# 管理员令牌（留空则自动生成并保存到 data/admin-token）
# ODYSSEY_ADMIN_TOKEN=change-me

# 登录会话有效天数
ODYSSEY_SESSION_DAYS=30

# AI（留空则 AI 功能返回 503，其他功能不受影响）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 离线演示：设为 1 时不调用真实 API
# ODYSSEY_AI_MOCK=1
