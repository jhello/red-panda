[Unit]
Description=Red Panda (小熊猫) journey server
Documentation=file:///opt/red-panda/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 修改为实际运行用户与项目路径
User=red-panda
Group=red-panda
WorkingDirectory=/opt/red-panda

# 可选：从受权限保护的文件读取密钥，避免把密钥写进本单元
# EnvironmentFile=-/etc/red-panda/red-panda.env
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=8787
Environment=RED_PANDA_DATA_DIR=/opt/red-panda/data

ExecStart=/usr/bin/node /opt/red-panda/server/src/server.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

# 安全加固（按需调整）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/red-panda/data

[Install]
WantedBy=multi-user.target
